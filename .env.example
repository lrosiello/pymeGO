# === Aplicación ===
APP_ENV=development
APP_PORT=8080
CORS_ORIGINS=*

# === Base de datos PostgreSQL ===
# Formato: postgres://usuario:password@host:puerto/nombre_db?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/catalogogo?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# === JWT ===
# JWT_SECRET debe tener al menos 32 caracteres.
JWT_SECRET=cambiame-por-un-secreto-de-32-caracteres-minimo
JWT_ISSUER=catalogogo
JWT_EXPIRES_IN=24h

# === Catálogo ===
# Lista de precios de la instancia: b2c (minorista) o b2b (mayorista).
# Se aplica tanto a la vitrina pública como al total de los pedidos.
CATALOG_PRICE_MODE=b2c

# === WhatsApp ===
# Número destino (con código de país, sin '+') usado para armar el link wa.me.
WHATSAPP_NUMBER=5491122334455
